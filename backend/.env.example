# Ma'lumotlar bazasi. Ishlab chiqarishda PostgreSQL ishlating:
# DATABASE_URL=postgresql+psycopg://autoservis:parol@localhost:5432/autoservis
DATABASE_URL=sqlite:///./autoservis.db

# Albatta o'zgartiring! Masalan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173"]
TIMEZONE=Asia/Tashkent

# SMS: console (faqat log) yoki eskiz (notify.eskiz.uz)
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Eslatma SMS'larini avtomatik yuborish (ish vaqtida har soatda)
REMINDERS_AUTORUN=true
REMINDERS_INTERVAL_MINUTES=60
REMINDERS_HOUR_FROM=9
REMINDERS_HOUR_TO=20
